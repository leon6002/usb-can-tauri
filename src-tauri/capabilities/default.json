{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main",
    "debug-panel"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "core:event:allow-listen",
    "core:window:allow-set-fullscreen",
